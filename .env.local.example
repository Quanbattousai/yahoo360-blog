# Supabase — copy this file to .env.local and fill in your project values.
# Find these in Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL of the app (used for OAuth redirects). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Unsplash Access Key for live wallpaper search (Settings → API on
# unsplash.com/developers). If unset, the wallpaper browser uses a curated
# fallback set — no key required for the app to work.
UNSPLASH_ACCESS_KEY=
